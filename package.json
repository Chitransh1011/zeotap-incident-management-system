{
  "name": "zeotap-ims-assignment",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "docker compose up --build",
    "backend:start": "uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 4000",
    "backend:test": "python -m pytest backend/tests",
    "frontend:install": "npm --prefix frontend install",
    "frontend:build": "npm --prefix frontend run build",
    "pdf": "python scripts/generate_submission_pdf.py"
  }
}
